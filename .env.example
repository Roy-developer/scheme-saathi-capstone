# Copy this file to .env. Keep chat and embedding credentials separate.
OPENROUTER_API_KEY=your_openrouter_chat_key_here
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY_FREE=your_openrouter_embedding_key_here
OPENROUTER_EMBEDDING_MODEL=voyageai/voyage-4
# Free vision model that reads uploaded document images (uses the free key above if set).
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
SCHEME_SAATHI_PORTAL_URL=http://127.0.0.1:8765
SCHEME_SAATHI_PORTAL_DB=data/runtime/portal.sqlite3
