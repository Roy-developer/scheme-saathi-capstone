# Copy this file to .env. App chat and rule-extraction credentials are separate.
OPENROUTER_API_KEY=your_openrouter_chat_key_here
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY_FREE=your_openrouter_free_key_here
OPENROUTER_CHAT_MODEL_FREE=nvidia/nemotron-3.5-lightning:free
OPENROUTER_RULE_EXTRACTION_MODEL=nvidia/nemotron-3.5-lightning:free
SCHEME_SAATHI_EMBEDDING_BACKEND=fastembed
SCHEME_SAATHI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENROUTER_EMBEDDING_MODEL=voyageai/voyage-4
SCHEME_SAATHI_PORTAL_URL=http://127.0.0.1:8765
SCHEME_SAATHI_PORTAL_DB=data/runtime/portal.sqlite3
