{
  "dataset_version": "0.3.0",
  "purpose": "Development cases for rule-extraction Reflexion. Each case is one clause of an approved rule package; its text, rules and facts are read from the package at run time, so nothing here duplicates policy.",
  "split_rules": "learn: lessons may be proposed from this clause. check: measured only, never learned from, so it stays valid for before/after comparison and demos. null: not yet assigned; learn refuses it. Assign a split before anything learns from a clause.",
  "context_rules": "A clause in a list is shown to the model after the headings it sits under in the source, so the model sees what a person reading the document sees. Headings are copied word for word and are never compared or stored as rule evidence.",
  "topic_tags": {
    "inclusion_clause": "States who qualifies.",
    "exclusion_clause": "States who is not eligible; the approved rule is usually fact eq false."
  },
  "reviewer_rules": "Any project team member may review lessons. Use your GitHub login after --reviewer.",
