{
  "title": "Scheme Saathi Role 5/6 overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "panels": [
    {
      "type": "timeseries",
      "title": "Panel 1: Questions asked",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(scheme_saathi_questions_total[5m]))",
          "legendFormat": "questions/s"
        },
        {
          "expr": "sum by (scheme_id) (rate(scheme_saathi_questions_total[5m]))",
          "legendFormat": "{{scheme_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Panel 2: Can't-tell / need_more_information rate (alert)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(scheme_saathi_verdicts_total{result=\"need_more_information\"}[5m])) / clamp_min(sum(rate(scheme_saathi_verdicts_total[5m])), 1e-9)",
          "legendFormat": "cant_tell_rate"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Panel 3: Pending approvals",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "scheme_saathi_pending_approvals",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Panel 4: Masked-ID hits",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "sum by (field_type) (rate(scheme_saathi_masked_id_hits_total[5m]))",
          "legendFormat": "{{field_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Panel 5: Cost p95 (USD)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(scheme_saathi_cost_usd_bucket[5m])) by (le))",
          "legendFormat": "p95_cost_usd"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(scheme_saathi_cost_usd_bucket[5m])) by (le))",
          "legendFormat": "p50_cost_usd"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request / LLM latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(scheme_saathi_request_latency_seconds_bucket[5m])))",
          "legendFormat": "http_p95 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(scheme_saathi_llm_call_seconds_bucket[5m])))",
          "legendFormat": "llm_p95 {{model}}"
        }
      ]
    }
  ]
}
